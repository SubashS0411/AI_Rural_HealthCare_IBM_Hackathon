# Development environment settings.
# Copy to .env and adjust before deploying to production.

# Set to True ONLY in development — enables demo user seeding and auto-reload
DEBUG=True

# Generate a strong random key for production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=c8c3748d27ef34f6cfc4a884d53a7eee13a2ff50d1eac1f8db7485da1248a3be

# Database (SQLite for dev, can be swapped for PostgreSQL)
DATABASE_URL=sqlite:///./health_intelligence.db
